diff --git a/src/backend/nodes/nodeFuncs.c b/src/backend/nodes/nodeFuncs.c
index 9512a6a824a..d7191a98d9d 100644
--- a/src/backend/nodes/nodeFuncs.c
+++ b/src/backend/nodes/nodeFuncs.c
@@ -692,6 +692,30 @@ relabel_to_typmod(Node *expr, int32 typmod)
 							COERCE_EXPLICIT_CAST, -1, false);
 }
 
+/*
+ * strip_typmod_relabel
+ *		Remove RelabelType nodes that change just the typmod of the expression.
+ *
+ * Such a node does not change the value or how it compares, so code matching
+ * expressions with equal() can look through it.  A RelabelType that changes
+ * the type or the collation is kept.  This doesn't modify or copy the input
+ * expression tree, just returns a pointer to a suitable place within it.
+ */
+Node *
+strip_typmod_relabel(Node *expr)
+{
+	while (expr && IsA(expr, RelabelType))
+	{
+		RelabelType *r = (RelabelType *) expr;
+
+		if (r->resulttype != exprType((Node *) r->arg) ||
+			r->resultcollid != exprCollation((Node *) r->arg))
+			break;
+		expr = (Node *) r->arg;
+	}
+	return expr;
+}
+
 /*
  * strip_implicit_coercions: remove implicit coercions at top level of tree

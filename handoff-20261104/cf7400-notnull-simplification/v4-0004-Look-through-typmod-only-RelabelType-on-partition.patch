 --
+-- Constant folding keeps the typmod of a rebuilt CASE, COALESCE or NULLIF
+-- with a typmod-only RelabelType, both in the partition key and in quals
+--
+create function relabel_part_f(numeric) returns numeric
+  language sql immutable as 'select $1';
+create table relabel_part (a numeric(10), b numeric(10))
+  partition by list ((coalesce(relabel_part_f(a), b)));
+create table relabel_part1 partition of relabel_part for values in (1);
+create table relabel_part2 partition of relabel_part for values in (2);
+create table relabel_part_null partition of relabel_part for values in (null);
+explain (costs off)
+select * from relabel_part where coalesce(relabel_part_f(a), b) = 1;
+                      QUERY PLAN                      
+------------------------------------------------------
+ Seq Scan on relabel_part1 relabel_part
+   Filter: ((COALESCE(a, b))::numeric = '1'::numeric)
+(2 rows)
+
+explain (costs off)
+select * from relabel_part where coalesce(relabel_part_f(a), b) in (2, 3);
+                            QUERY PLAN                            
+------------------------------------------------------------------
+ Seq Scan on relabel_part2 relabel_part
+   Filter: ((COALESCE(a, b))::numeric = ANY ('{2,3}'::numeric[]))
+(2 rows)
+
+explain (costs off)
+select * from relabel_part where coalesce(relabel_part_f(a), b) is null;
+                  QUERY PLAN                   
+-----------------------------------------------
+ Seq Scan on relabel_part_null relabel_part
+   Filter: ((COALESCE(a, b))::numeric IS NULL)
+(2 rows)
+
+-- run-time pruning
+prepare relabel_part_q (numeric) as
+  select * from relabel_part where coalesce(relabel_part_f(a), b) = $1;
+set plan_cache_mode = force_generic_plan;
+explain (costs off) execute relabel_part_q (1);
+                    QUERY PLAN                    
+--------------------------------------------------
+ Append
+   Subplans Removed: 2
+   ->  Seq Scan on relabel_part1 relabel_part_1
+         Filter: ((COALESCE(a, b))::numeric = $1)
+(4 rows)
+
+reset plan_cache_mode;
+deallocate relabel_part_q;
+drop table relabel_part;
+drop function relabel_part_f(numeric);

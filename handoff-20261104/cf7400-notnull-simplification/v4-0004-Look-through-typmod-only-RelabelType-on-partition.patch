+-- The partition key and the GROUP BY expression can both carry a
+-- typmod-only RelabelType kept by constant folding
+CREATE FUNCTION pagg_relabel_f(numeric) RETURNS numeric
+  LANGUAGE sql IMMUTABLE AS 'SELECT $1';
+CREATE TABLE pagg_relabel (a numeric(10), b numeric(10))
+  PARTITION BY LIST ((COALESCE(pagg_relabel_f(a), b)));
+CREATE TABLE pagg_relabel_p1 PARTITION OF pagg_relabel FOR VALUES IN (1);
+CREATE TABLE pagg_relabel_p2 PARTITION OF pagg_relabel FOR VALUES IN (2);
+EXPLAIN (COSTS OFF)
+SELECT COALESCE(pagg_relabel_f(a), b), count(*) FROM pagg_relabel GROUP BY 1;
+                                 QUERY PLAN                                 
+----------------------------------------------------------------------------
+ Append
+   ->  HashAggregate
+         Group Key: (COALESCE(pagg_relabel.a, pagg_relabel.b))::numeric
+         ->  Seq Scan on pagg_relabel_p1 pagg_relabel
+   ->  HashAggregate
+         Group Key: (COALESCE(pagg_relabel_1.a, pagg_relabel_1.b))::numeric
+         ->  Seq Scan on pagg_relabel_p2 pagg_relabel_1
+(7 rows)
+
+DROP TABLE pagg_relabel;
+DROP FUNCTION pagg_relabel_f(numeric);

+-- The partition keys can carry a typmod-only RelabelType kept by constant
+-- folding, while the join clause operands are relabeled to text
+CREATE FUNCTION prt_relabel_f(varchar) RETURNS varchar
+  LANGUAGE sql IMMUTABLE AS 'SELECT $1';
+CREATE TABLE prt_relabel1 (a varchar(3), b varchar(3))
+  PARTITION BY LIST ((COALESCE(prt_relabel_f(a), b)));
+CREATE TABLE prt_relabel1_p1 PARTITION OF prt_relabel1 FOR VALUES IN ('a');
+CREATE TABLE prt_relabel1_p2 PARTITION OF prt_relabel1 FOR VALUES IN ('b');
+CREATE TABLE prt_relabel2 (a varchar(3), b varchar(3))
+  PARTITION BY LIST ((COALESCE(prt_relabel_f(a), b)));
+CREATE TABLE prt_relabel2_p1 PARTITION OF prt_relabel2 FOR VALUES IN ('a');
+CREATE TABLE prt_relabel2_p2 PARTITION OF prt_relabel2 FOR VALUES IN ('b');
+EXPLAIN (COSTS OFF)
+SELECT * FROM prt_relabel1 t1 JOIN prt_relabel2 t2
+  ON COALESCE(prt_relabel_f(t1.a), t1.b) = COALESCE(prt_relabel_f(t2.a), t2.b);
+                                          QUERY PLAN                                           
+-----------------------------------------------------------------------------------------------
+ Append
+   ->  Merge Join
+         Merge Cond: (((COALESCE(t1_1.a, t1_1.b))::text) = ((COALESCE(t2_1.a, t2_1.b))::text))
+         ->  Sort
+               Sort Key: ((COALESCE(t1_1.a, t1_1.b))::text)
+               ->  Seq Scan on prt_relabel1_p1 t1_1
+         ->  Sort
+               Sort Key: ((COALESCE(t2_1.a, t2_1.b))::text)
+               ->  Seq Scan on prt_relabel2_p1 t2_1
+   ->  Merge Join
+         Merge Cond: (((COALESCE(t1_2.a, t1_2.b))::text) = ((COALESCE(t2_2.a, t2_2.b))::text))
+         ->  Sort
+               Sort Key: ((COALESCE(t1_2.a, t1_2.b))::text)
+               ->  Seq Scan on prt_relabel1_p2 t1_2
+         ->  Sort
+               Sort Key: ((COALESCE(t2_2.a, t2_2.b))::text)
+               ->  Seq Scan on prt_relabel2_p2 t2_2
+(17 rows)
+
+DROP TABLE prt_relabel1, prt_relabel2;
+DROP FUNCTION prt_relabel_f(varchar);
 RESET enable_partitionwise_join;
